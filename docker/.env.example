# MySQL配置
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=zscx
MYSQL_USER=zscx
MYSQL_PASSWORD=zscx123456
MYSQL_PORT=3306

# Web应用配置
WEB_PORT=3000
APP_NAME=房屋征收调查系统
# JWT密钥（必填！启动前必须设置一个随机密钥）
# 生成方法：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-secret-to-a-random-string-in-production
# Cookie Secure标志：true=仅HTTPS传输，false=HTTP/HTTPS都可用（默认false，内网HTTP部署时保持false）
COOKIE_SECURE=false

# 数据库连接（开发用）
DATABASE_URL=mysql://root:root123456@localhost:3306/zscx

# ONLYOFFICE Document Server（模板编辑器）——由 docker compose 的 onlyoffice-ds 服务自动拉取部署
# 内网访问时浏览器加载 DS 的地址（office-config 对内网请求返回的 ds）
ONLYOFFICE_DS_URL=http://127.0.0.1:8088
# 外网访问时浏览器加载 DS 的地址；DS 为 http 直连时必须用 http
# （https 页面无法加载 http 的 DS，浏览器混合内容拦截；模板设计须走 http 页面）
ONLYOFFICE_PUBLIC_DS_URL=http://YOUR_PUBLIC_HOST:8088
# DS JWT 密钥（必须与 docker-compose.yml 中 onlyoffice-ds 服务的 JWT_SECRET 保持一致）
ONLYOFFICE_JWT_SECRET=change-this-secret-please
# DS 后端下载 document.url / 回调的内网可达地址（compose 同网络可直接用 web 服务名）
ONLYOFFICE_INTERNAL_URL=http://zscx-web:3000
